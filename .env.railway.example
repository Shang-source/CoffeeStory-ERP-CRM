# StoryCoffee Railway demo variables
# Paste these into the Railway web service variables and replace placeholders.

ASPNETCORE_ENVIRONMENT=Production

# Railway injects PORT at runtime. Leave unset unless you manually target port 8080.
# PORT=8080

# Railway PostgreSQL reference variables. If your database service has a different
# name, replace "Postgres" with the exact Railway service name.
ConnectionStrings__DefaultConnection=Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};Database=${{Postgres.PGDATABASE}};Username=${{Postgres.PGUSER}};Password=${{Postgres.PGPASSWORD}};SSL Mode=Require;Trust Server Certificate=true

Jwt__Issuer=StoryCoffee
Jwt__Audience=StoryCoffee.App
Jwt__Secret=replace-with-strong-random-32-plus-character-secret
Jwt__ExpiryMinutes=480

# Set this after Railway generates the public domain for the web service.
# If using Cloudflare, prefer a first-level subdomain such as https://app.yourdomain.com.
Portal__BaseUrl=https://replace-with-your-railway-domain.up.railway.app

# Single-service Railway demo serves frontend and API from the same origin.
# Keep CORS narrow if you later split frontend/API into two services.
# If using Cloudflare, set this to the same custom domain as Portal__BaseUrl.
Cors__AllowedOrigins__0=https://replace-with-your-railway-domain.up.railway.app

# Demo-only seed data. Turn this off before real customer data import.
SeedData__Enabled=true
SeedData__EnableInDevelopment=false
SeedData__EnableInTesting=false

Redis__Enabled=false
Redis__ConnectionString=

# Railway demo document storage. Recommended: attach a Railway volume at /var/storycoffee-files.
DocumentStorage__Provider=Local
DocumentStorage__LocalRoot=/var/storycoffee-files
DocumentStorage__SigningSecret=replace-with-strong-random-document-signing-secret
DocumentStorage__PresignedUrlMinutes=15

# Demo-safe email mode. Use Smtp when you are ready to send real customer mail.
# To use Resend, set Email__Provider=Resend and provide Email__ResendApiKey.
Email__Provider=Stub
Email__FromName=StoryCoffee
Email__FromAddress=no-reply@storycoffee.co.nz
Email__ResendApiKey=
Email__ResendApiUrl=https://api.resend.com/
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
Email__UseStartTls=true
Email__VerifySnsSignature=false
Email__AutoConfirmSnsSubscriptions=false
Email__WebhookSecret=

Outbox__Enabled=true
Outbox__PollIntervalSeconds=30
Outbox__BatchSize=20
Outbox__RetryDelaySeconds=300
Outbox__MaxAttempts=5
Outbox__LockTimeoutSeconds=300
