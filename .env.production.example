# Copy this file to .env.production on the VPS.
# Never commit the real .env.production file.

APP_DOMAIN=app.storycoffee.co.nz
ACME_EMAIL=admin@storycoffee.co.nz

POSTGRES_DB=storycoffee
POSTGRES_USER=storycoffee
POSTGRES_PASSWORD=replace-with-strong-postgres-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY_MINUTES=480

REDIS_ENABLED=true

# Lowest-cost default: keep PDFs on the VPS volume and back them up.
# Switch to S3/R2 only after credentials and bucket policy are ready.
DOCUMENT_STORAGE_PROVIDER=Local
DOCUMENT_STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-characters
DOCUMENT_STORAGE_PRESIGNED_URL_MINUTES=15
DOCUMENT_STORAGE_BUCKET_NAME=storycoffee-documents
DOCUMENT_STORAGE_S3_REGION=ap-southeast-2
DOCUMENT_STORAGE_SERVICE_URL=
DOCUMENT_STORAGE_ACCESS_KEY=
DOCUMENT_STORAGE_SECRET_KEY=
DOCUMENT_STORAGE_FORCE_PATH_STYLE=true

# Recommended low-cost first production email: SMTP through Brevo.
# SES can be enabled later by setting EMAIL_PROVIDER=SES and SES values.
EMAIL_PROVIDER=Smtp
EMAIL_FROM_NAME=StoryCoffee
EMAIL_FROM_ADDRESS=no-reply@storycoffee.co.nz
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=replace-with-smtp-login
EMAIL_SMTP_PASSWORD=replace-with-smtp-password
EMAIL_USE_START_TLS=true
EMAIL_WEBHOOK_SECRET=replace-with-webhook-secret-or-leave-unused-for-smtp
EMAIL_VERIFY_SNS_SIGNATURE=true
EMAIL_AUTO_CONFIRM_SNS_SUBSCRIPTIONS=false
EMAIL_SNS_TOPIC_ARN=
EMAIL_SES_REGION=ap-southeast-2
EMAIL_SES_CONFIGURATION_SET=

OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=30
OUTBOX_BATCH_SIZE=20
OUTBOX_RETRY_DELAY_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_TIMEOUT_SECONDS=300

# Optional off-server backup upload target, for example s3://storycoffee-backups/prod.
# For Cloudflare R2, set BACKUP_S3_ENDPOINT_URL and AWS credentials in this file.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
